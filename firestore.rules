rules_version = '2';

// MARKA Firestore security rules.
//
// Principle: a user can only ever touch documents they own. Ownership is
// `ownerId == request.auth.uid` on every collection except `users`, which is
// keyed by uid directly.
//
// Assistant messages are deliberately NOT client-writable. They are written by
// Cloud Functions through the Admin SDK, which bypasses these rules — so a
// client cannot forge a reply from MARKA.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The document already stored belongs to the caller.
    function ownsExisting() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // The document being written claims the caller as its owner.
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Ownership and creation time can never be rewritten after the fact.
    function immutableFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // --- users ---------------------------------------------------------
    // A profile is readable and writable only by its own account. Deletion is
    // denied: account removal must go through a backend that also cleans up
    // the user's businesses, conversations and files.
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // --- businesses ----------------------------------------------------
    // The Business Brain is jointly written: the owner edits the business
    // facts, while website analysis is produced by Cloud Functions.
    //
    // `discovery` and `sources` are the record of what the backend actually
    // did — which site was analysed, when, how many pages, whether it
    // succeeded. They carry more authority than anything the client asserts,
    // so the client may never write them. Functions use the Admin SDK, which
    // bypasses these rules.
    //
    // `provenance` and the per-section source stamps stay client-writable on
    // purpose: the only authority a client can honestly claim there is the
    // owner's own, and the owner already outranks every discovered value. A
    // forged stamp would only downgrade their own data.
    match /businesses/{businessId} {

      // A newly created business has not been analysed yet. This is the
      // manual path (name plus what they sell); the analysed path is created
      // server-side.
      function pristineDiscovery() {
        let discovery = request.resource.data.get('discovery', {});
        return discovery.get('status', 'not_started') == 'not_started'
          && discovery.get('sourceRef', null) == null
          && discovery.get('completedAt', null) == null
          && discovery.get('pagesAnalysed', 0) == 0
          && request.resource.data.get('sources', []).size() == 0;
      }

      // An update must leave the backend's own record exactly as it found it.
      function serverFieldsUnchanged() {
        return request.resource.data.get('discovery', null) == resource.data.get('discovery', null)
          && request.resource.data.get('sources', null) == resource.data.get('sources', null);
      }

      allow get, list: if ownsExisting();
      allow create: if ownsIncoming() && pristineDiscovery();
      allow update: if ownsExisting()
        && ownsIncoming()
        && immutableFieldsUnchanged()
        && serverFieldsUnchanged();
      allow delete: if ownsExisting();
    }

    // --- conversations and their messages -------------------------------
    match /conversations/{conversationId} {
      // A conversation may claim a business only if the caller owns it —
      // otherwise the assistant would read another owner's Business Brain
      // into this thread's context. `null` is the legitimate pre-onboarding
      // state. Once set, the claim is frozen: repointing a conversation at a
      // different business would silently swap whose data feeds its replies.
      function conversationBusinessValid() {
        return request.resource.data.get('businessId', null) == null
          || get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
            .data.ownerId == request.auth.uid;
      }

      function conversationBusinessUnchanged() {
        return request.resource.data.get('businessId', null)
          == resource.data.get('businessId', null);
      }

      allow get, list: if ownsExisting();
      allow create: if ownsIncoming() && conversationBusinessValid();
      allow update: if ownsExisting()
        && ownsIncoming()
        && immutableFieldsUnchanged()
        && conversationBusinessUnchanged();
      allow delete: if ownsExisting();

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function ownsConversation() {
          return isSignedIn() && parentConversation().ownerId == request.auth.uid;
        }

        allow get, list: if ownsConversation();

        // Clients may only ever add their own turn. MARKA's replies come from
        // the Admin SDK, so 'assistant' and 'system' are refused here.
        allow create: if ownsConversation()
          && ownsIncoming()
          && request.resource.data.role == 'user';

        // Messages are an immutable record of the conversation.
        allow update: if false;
        allow delete: if ownsConversation();
      }

      // Chat attachments: conversation-scoped files referenced by message
      // blocks. Identity is fixed at creation — every field that says what
      // the file is, where it lives and how it arrived is frozen, so an
      // attachment can never be repointed at a file that was not created
      // for it. Only `status` may change (soft delete).
      match /attachments/{attachmentId} {
        function attachmentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function ownsAttachmentConversation() {
          return isSignedIn() && attachmentConversation().ownerId == request.auth.uid;
        }

        // An uploaded file must sit in this conversation's own attachments
        // folder, inside a business the caller actually owns.
        function uploadAttachmentValid() {
          return request.resource.data.assetId == null
            && request.resource.data.storagePath
              .matches('businesses/' + request.resource.data.businessId
                + '/conversations/' + conversationId + '/attachments/.+')
            && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
              .data.ownerId == request.auth.uid;
        }

        // An Asset reference must name a real Asset the caller owns, in the
        // same business, still active and cleared for EVA — and the recorded
        // storagePath must be *that Asset's* path, never a client invention.
        function assetAttachmentValid() {
          let asset = get(/databases/$(database)/documents/assets/$(request.resource.data.assetId)).data;
          return request.resource.data.assetId != null
            && asset.ownerId == request.auth.uid
            && asset.businessId == request.resource.data.businessId
            && asset.status == 'active'
            && asset.allowAiUse == true
            && asset.storagePath == request.resource.data.storagePath;
        }

        function attachmentIdentityFrozen() {
          return request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
            && request.resource.data.get('businessId', null) == resource.data.get('businessId', null)
            && request.resource.data.get('conversationId', null) == resource.data.get('conversationId', null)
            && request.resource.data.get('messageId', null) == resource.data.get('messageId', null)
            && request.resource.data.get('fileName', null) == resource.data.get('fileName', null)
            && request.resource.data.get('contentType', null) == resource.data.get('contentType', null)
            && request.resource.data.get('sizeBytes', null) == resource.data.get('sizeBytes', null)
            && request.resource.data.get('storagePath', null) == resource.data.get('storagePath', null)
            && request.resource.data.get('source', null) == resource.data.get('source', null)
            && request.resource.data.get('assetId', null) == resource.data.get('assetId', null)
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
        }

        allow get, list: if ownsAttachmentConversation();

        allow create: if ownsAttachmentConversation()
          && ownsIncoming()
          && request.resource.data.conversationId == conversationId
          && request.resource.data.messageId is string
          && request.resource.data.status == 'active'
          && request.resource.data.contentType in
            ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 10485760
          && (
            (request.resource.data.source == 'upload' && uploadAttachmentValid())
            || (request.resource.data.source == 'asset' && assetAttachmentValid())
          );

        allow update: if ownsAttachmentConversation() && attachmentIdentityFrozen();
        allow delete: if ownsAttachmentConversation();
      }
    }

    // --- campaigns, creatives, calendar, results ------------------------
    // Campaigns are created only by Cloud Functions (from a recommendation,
    // through the Admin SDK) — no client code path creates one, so client
    // creation is refused outright rather than left open. The owner edits
    // the strategy fields directly.
    //
    // `sourceRecommendationId` is the server's record that the campaign was
    // built from a real recommendation, and `businessId` / `conversationId`
    // anchor it to what it was built for — all frozen on update.
    match /campaigns/{campaignId} {

      function campaignServerFieldsUnchanged() {
        return request.resource.data.get('sourceRecommendationId', null)
            == resource.data.get('sourceRecommendationId', null)
          && request.resource.data.get('businessId', null)
            == resource.data.get('businessId', null)
          && request.resource.data.get('conversationId', null)
            == resource.data.get('conversationId', null);
      }

      allow get, list: if ownsExisting();
      allow create: if false;
      allow update: if ownsExisting()
        && ownsIncoming()
        && immutableFieldsUnchanged()
        && campaignServerFieldsUnchanged();
      allow delete: if ownsExisting();
    }

    // Creatives are generated only by Cloud Functions from a campaign the
    // caller owns — a client that could create one could forge the chain
    // Creative → Campaign → Recommendation, so creation is refused outright.
    // The owner may edit the copy fields directly, but the provenance anchors
    // (`campaignId`, `businessId`, `conversationId`, `sourceRecommendationId`),
    // the image reference (whose storagePath points into Storage the server
    // wrote, and whose assetId names the source Asset), the asset provenance
    // list (`assetIds`) and the logo snapshot fields are frozen — a client
    // that could change any of them could claim another business's files or
    // falsify which Assets a creative uses.
    match /creatives/{creativeId} {

      function creativeServerFieldsUnchanged() {
        return request.resource.data.get('campaignId', null)
            == resource.data.get('campaignId', null)
          && request.resource.data.get('businessId', null)
            == resource.data.get('businessId', null)
          && request.resource.data.get('conversationId', null)
            == resource.data.get('conversationId', null)
          && request.resource.data.get('sourceRecommendationId', null)
            == resource.data.get('sourceRecommendationId', null)
          && request.resource.data.get('content', {}).get('image', null)
            == resource.data.get('content', {}).get('image', null)
          && request.resource.data.get('assetIds', null)
            == resource.data.get('assetIds', null)
          && request.resource.data.get('style', {}).get('logoAssetId', null)
            == resource.data.get('style', {}).get('logoAssetId', null)
          && request.resource.data.get('style', {}).get('logoStoragePath', null)
            == resource.data.get('style', {}).get('logoStoragePath', null);
      }

      allow get, list: if ownsExisting();
      allow create: if false;
      allow update: if ownsExisting()
        && ownsIncoming()
        && immutableFieldsUnchanged()
        && creativeServerFieldsUnchanged();
      allow delete: if ownsExisting();
    }

    // The calendar does not exist as a feature yet — no client code touches
    // this collection. Until it does, clients get read access to their own
    // documents (harmless) and no writes: an open write surface on a
    // collection nothing legitimate writes to is pure attack surface.
    match /calendarItems/{itemId} {
      allow get, list: if ownsExisting();
      allow create, update, delete: if false;
    }

    // Performance data is written by backend ingestion, never by the client —
    // a client that could write results could fabricate the numbers the
    // product reports back as truth. Results ingestion does not exist yet and
    // no client code reads or deletes these, so all client writes (deletion
    // included — results are the append-only record recommendations will be
    // judged against) are refused.
    match /results/{resultId} {
      allow get, list: if ownsExisting();
      allow create, update, delete: if false;
    }

    // --- assets ----------------------------------------------------------
    // Owner-uploaded business materials (photos, menus, logos, PDFs). The
    // client uploads the file and then creates this document, so creation is
    // allowed — but the storage path must point inside the assets folder of
    // the business the document claims, and the file's identity (path, name,
    // type, size, how it arrived) is frozen after creation so a document can
    // never be repointed at a file that was not uploaded for it.
    match /assets/{assetId} {

      function assetPathInOwnAssets() {
        return request.resource.data.storagePath
          .matches('businesses/' + request.resource.data.businessId + '/assets/.+');
      }

      // The claimed business must actually belong to the caller. Without this
      // lookup, a caller could create an asset document that claims someone
      // else's business with a path-consistent storagePath — a forged pointer
      // into files they do not own. Same ownership model as Storage's
      // `ownsBusiness` and the chat attachment upload rule.
      function ownsClaimedBusiness() {
        return get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
          .data.ownerId == request.auth.uid;
      }

      function assetServerFieldsUnchanged() {
        return request.resource.data.get('businessId', null)
            == resource.data.get('businessId', null)
          && request.resource.data.get('storagePath', null)
            == resource.data.get('storagePath', null)
          && request.resource.data.get('fileName', null)
            == resource.data.get('fileName', null)
          && request.resource.data.get('contentType', null)
            == resource.data.get('contentType', null)
          && request.resource.data.get('sizeBytes', null)
            == resource.data.get('sizeBytes', null)
          && request.resource.data.get('source', null)
            == resource.data.get('source', null);
      }

      allow get, list: if ownsExisting();
      allow create: if ownsIncoming() && assetPathInOwnAssets() && ownsClaimedBusiness();
      allow update: if ownsExisting()
        && ownsIncoming()
        && immutableFieldsUnchanged()
        && assetServerFieldsUnchanged();
      allow delete: if ownsExisting();
    }

    // --- recommendations ------------------------------------------------
    // Server-generated marketing intelligence. Like assistant messages,
    // recommendations are written only by Cloud Functions through the Admin
    // SDK — a client that could create or edit one could forge MARKA's
    // advice, so every client write except delete is refused. The owner may
    // read their own and delete ones they no longer want.
    match /recommendations/{recommendationId} {
      allow get, list: if ownsExisting();
      allow create: if false;
      allow update: if false;
      allow delete: if ownsExisting();
    }

    // --- subscriptions --------------------------------------------------
    // One document per uid: the account's subscription plan, which decides
    // which AI models serve it. Like recommendations, it is written only by
    // trusted server code through the Admin SDK — a client that could write
    // it could upgrade itself to Pro models without paying, so every client
    // write is refused. The owner may read their own plan.
    match /subscriptions/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // --- usage ----------------------------------------------------------
    // Phase 6B AI usage guardrail: one document per uid per UTC day,
    // holding request counts, token totals and estimated cost. Written only
    // by the guardrail transactions through the Admin SDK. Clients get no
    // access in either direction — even reads are denied, so quota internals
    // never become a client contract and a tampered client learns nothing
    // about how the limits work.
    match /usage/{usageId} {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
