# ---------------------------------------------------------------------------
# MARKA — client environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# EVERYTHING IN THIS FILE IS PUBLIC. Vite inlines every VITE_* value into the
# JavaScript bundle, so it is readable by anyone who opens the site.
#
# The Firebase web config is public by design — access is controlled by
# security rules, not by hiding these values.
#
# NEVER put an OpenAI key, a Billplz key, or a service account here.
# Server secrets are configured separately; see the section at the bottom.
# ---------------------------------------------------------------------------

# --- Firebase web config (Console → Project settings → Your apps → Web) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only if Google Analytics is enabled on the project.
VITE_FIREBASE_MEASUREMENT_ID=

# --- App configuration ------------------------------------------------------
# Must match the region the Cloud Functions are deployed to.
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# Set to "true" to point the app at local Firebase emulators.
VITE_USE_FIREBASE_EMULATORS=false

# Free-form label for the running environment: local | preview | production
VITE_APP_ENV=local


# ---------------------------------------------------------------------------
# SERVER SECRETS — DO NOT ADD THESE HERE
#
# These live in Firebase Cloud Functions secrets, not in any .env file that
# the frontend build can read:
#
#   firebase functions:secrets:set OPENAI_API_KEY
#
# Model selection can be overridden per deploy without a code change:
#
#   firebase functions:config:unset  # (v1 config is not used)
#   # set as function env vars in firebase.json or via the console:
#   MARKA_MODEL_REASONING=gpt-5.6-sol
#   MARKA_MODEL_FAST=gpt-5.6-terra
#   MARKA_MODEL_IMAGE=gpt-image-2
#
# Defaults live in functions/src/config/models.ts; these only override them.
# gpt-5.6-luna is the cheapest text tier and is a reasonable MARKA_MODEL_FAST
# for high-volume, low-judgement work.
#
# Billplz keys will follow the same pattern when payments are implemented.
# ---------------------------------------------------------------------------
