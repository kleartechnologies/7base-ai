rules_version = '2';

// MARKA Storage security rules.
//
// Every object lives under `businesses/{businessId}/…`. Access is granted by
// looking up the business document in Firestore and checking its `ownerId`,
// so file access can never diverge from data access.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // 20 MB ceiling; menus and brand assets are well under this.
    //
    // The type list is exact, not `image/*`: SVG is an image type but also a
    // script container, and nothing in the product uploads formats outside
    // these four. Server-side writes (generated creatives) use the Admin SDK
    // and bypass these rules, so this only constrains browsers.
    function isAllowedUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType in
          ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
    }

    match /businesses/{businessId}/{allPaths=**} {
      allow read: if ownsBusiness(businessId);
      allow write: if ownsBusiness(businessId) && isAllowedUpload();
      allow delete: if ownsBusiness(businessId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
